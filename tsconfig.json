{
    "compilerOptions": {
        "target": "ES2023",
        "module": "CommonJS",
        "lib": ["ES2023"],
        "declaration": true,
        "outDir": "./dist",
        "rootDir": "./src",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true
    },
    "exclude": ["node_modules"],
    "include": ["src/**/*.ts"]
}
